# 环境变量模板（docs/11-部署运维与发布规范.md §2）
# 规则：所有键留空或占位；真实值只进 .env（不入 git，权限 600）；禁止写进代码或镜像。
# 生成：cp .env.example .env && vi .env

# ---- PostgreSQL ----
# 应用运行账号：只有 SELECT/INSERT/UPDATE，没有 DELETE（docs/04 §6.2.1）
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=
POSTGRES_DB=garment_erp

# 应用连接串（erp_app）
DATABASE_URL=
# 迁移连接串（owner / erp_ddl），只在跑 alembic 时用，禁止进应用常驻进程
DATABASE_URL_MIGRATION=

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 认证 ----
# 生成：openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=15

# ---- 应用 ----
APP_ENV=local
SENTRY_DSN=

# ---- 首次部署 ----
# 初始超管（工号 ADMIN）的口令，由 seed_baseline 在"一个账号都没有"时创建。
# 至少 8 位含字母数字；留空则跳过创建（不生成弱口令）。
# 生成：openssl rand -base64 12
ERP_INITIAL_ADMIN_PASSWORD=

# ---- 员工端短信（阶段一测试通道，可空）----
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
